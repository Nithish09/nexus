# Copy to .env and fill in. Never commit .env.
NACE_API_KEY=
DEEPINFRA_API_KEY=

# Drex (System 1) on the Nace console. Uses NACE_API_KEY.
DREX_URL=https://console.nace.ai/v1/systemone
DREX_MODEL=drex-max-v1.1
# USD per 1M input tokens, from console.nace.ai/docs/drex/reference/pricing (output is not billed). Blank = cost shown as 0.
DREX_PRICE_PER_M_INPUT=

# Comparison / System 2 model on DeepInfra: use the exact model ID given by the organizers.
SYSTEM2_URL=https://api.deepinfra.com/v1/openai/chat/completions
SYSTEM2_MODEL=
SYSTEM2_PRICE_PER_M_INPUT=
SYSTEM2_PRICE_PER_M_OUTPUT=

# NDI (document Extract) runs through nace-sdk whenever NACE_API_KEY is set. Set NDI_URL=off to force the local extractor.
NDI_URL=

API_TIMEOUT_S=30

# Hybrid provider: escalate to the System 2 LLM when Drex confidence is below this.
HYBRID_THRESHOLD=0.6
